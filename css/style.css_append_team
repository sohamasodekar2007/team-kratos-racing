
/* =========================================
   6. TEAM & SUB-PAGE STYLES
   ========================================= */

/* Year Cards (team.html) */
.team-years-section {
    padding: 100px 0;
    position: relative;
    min-height: 80vh;
}

.team-years-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    margin-top: 60px;
}

.year-card {
    display: block;
    height: 100%;
    text-decoration: none;
    perspective: 1000px;
}

.year-card-inner {
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--border-glass);
    border-radius: 20px;
    padding: 40px;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.4s var(--ease-elastic);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-glass);
}

.year-card:hover .year-card-inner {
    transform: translateY(-10px);
    border-color: var(--primary);
    box-shadow: var(--shadow-glow);
}

.year-icon {
    color: var(--primary);
    margin-bottom: 20px;
    transition: transform 0.4s ease;
}

.year-card:hover .year-icon {
    transform: scale(1.1) rotate(5deg);
    color: var(--accent);
}

.year-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    margin-bottom: 10px;
    color: var(--text-main);
}

.year-description {
    color: var(--text-muted);
    margin-bottom: 30px;
    flex-grow: 1;
}

.year-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--primary);
    color: white;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.card-arrow {
    color: var(--primary);
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.4s ease;
}

.year-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
}

/* Department Sections (Team Pages) */
.department-section {
    padding: 60px 0;
    border-bottom: 1px solid var(--border-glass);
}

.department-section:last-child {
    border-bottom: none;
}

.department-header {
    margin-bottom: 50px;
    padding-left: 20px;
    border-left: 4px solid var(--primary);
}

.department-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    color: var(--text-main);
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 0 20px rgba(0, 71, 171, 0.3);
}

/* Team Grid & Cards */
.team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 30px;
}

.team-card {
    height: 400px; /* Fixed height for flip effect */
    perspective: 1000px;
    background: transparent;
}

.card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform 0.8s;
    transform-style: preserve-3d;
    border-radius: 15px;
    box-shadow: var(--shadow-glass);
}

.team-card:hover .card-inner {
    transform: rotateY(180deg);
}

.card-front, .card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 15px;
    overflow: hidden;
    background: var(--bg-glass);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--border-glass);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Front Side */
.member-img-placeholder {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 25px;
    border: 3px solid var(--primary);
    box-shadow: 0 0 20px rgba(0, 71, 171, 0.3);
    background: #1a1a1a; /* Fallback */
}

.member-info h3 {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    margin-bottom: 5px;
    color: var(--text-main);
}

.member-info span {
    color: var(--secondary);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 1px;
}

/* Back Side */
.card-back {
    background: linear-gradient(145deg, var(--bg-dark), #1a1a1a);
    transform: rotateY(180deg);
    padding: 30px;
    border-color: var(--primary);
}

.card-back h3 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: 15px;
    color: var(--primary);
}

.card-back p {
    font-style: italic;
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 25px;
    line-height: 1.6;
}

.social-links {
    display: flex;
    gap: 15px;
    margin-top: auto;
}

.social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-main);
    transition: all 0.3s ease;
}

.social-links a:hover {
    background: var(--primary);
    box-shadow: 0 0 15px var(--primary-glow);
    transform: translateY(-3px);
    border-color: var(--primary);
}
